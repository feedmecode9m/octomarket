# OctoMarket environment variables
# Copy to .env for local development

# Runtime
# development (default) keeps FLASK_DEBUG=True unless overridden
# production / Railway: set ENV=production (forces debug off unless FLASK_DEBUG set)
ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
HOST=0.0.0.0
PORT=5000

# JSONL persistence root (local: ./data ; Railway volume: /data)
# DATA_DIR=/data
DEPLOYMENT_GATE=17B

# Trading Configuration
DEFAULT_SYMBOL=AAPL
DEFAULT_INTERVAL=1m
DEFAULT_PERIOD=1d
DEFAULT_INITIAL_CASH=50000

# Data Fetching Configuration
MAX_RETRIES=5
RETRY_DELAY=10

# Strategy Configuration
DEFAULT_SHORT_WINDOW=2
DEFAULT_LONG_WINDOW=5

# Chart Configuration
MAX_PORTFOLIO_VALUES=100
CHART_UPDATE_INTERVAL=5000
